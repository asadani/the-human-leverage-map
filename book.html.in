 color:#fff;display:grid;place-items:center;font-size:15px}
.ba-hd>div{flex:1;min-width:0}
.ba-kick{display:block;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;
 color:var(--ba-dim)}
